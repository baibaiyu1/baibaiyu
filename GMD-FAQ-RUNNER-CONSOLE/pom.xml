<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.gmd.faq.server.main</groupId>
        <artifactId>GMD-FAQ-SERVER-MAIN</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>GMD-FAQ-RUNNER-CONSOLE</artifactId>
    <packaging>jar</packaging>

    <name>GMD-FAQ-RUNNER-CONSOLE</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-ACCOUNT</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-RESOURCE</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-SK</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-WORKFLOW</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-DASHBOARD</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-CHANNEL</artifactId>
        </dependency>
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-BIZ-GATEWAY</artifactId>
        </dependency>
        <!-- 心跳模块：仅使用 HeartbeatPayload DTO，optional 避免传递依赖 -->
        <dependency>
            <groupId>com.gmd.faq.server.main</groupId>
            <artifactId>GMD-FAQ-HEARTBEAT</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Flyway 数据库迁移：首次初始化由 sql/db_init.sql 完成，后续表结构变更统一走 classpath:db/migration 下的 V2__xxx.sql 增量脚本 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
