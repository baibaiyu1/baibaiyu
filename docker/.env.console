# ============================================================
# GMD-FAQ 生产部署 - 控制台节点 环境配置（.env.console）
# 部署位置：控制台服务器（Server 1）
# 使用方式：由 start-console.sh 自动复制为 .env（也可手动复制后填写实际值）
# ============================================================

# ==================== MySQL 配置 ====================
# 指向中间件服务器（Server 3）的 IP 地址
MYSQL_HOST=192.168.1.3
MYSQL_PORT=3306
MYSQL_DATABASE=gmd_faq_server
MYSQL_USER=root
MYSQL_PASSWORD=root

# ==================== Redis 配置 ====================
# 指向中间件服务器（Server 3）的 IP 地址
REDIS_HOST=192.168.1.3
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DATABASE=7

# ==================== 镜像仓库配置 ====================
DOCKER_REGISTRY=

# ==================== 后端配置 ====================
JWT_SECRET=replace-with-your-own-random-secret-at-least-32-bytes
CONSOLE_MEM_LIMIT=4g
CONSOLE_CPU_LIMIT=4
CONSOLE_JAVA_HEAP_PERCENTAGE=75.0

# ==================== 前端配置 ====================
FRONTEND_PORT=80
VITE_APP_BASE_API=/web
VITE_APP_CONTEXT_PATH=/web
# 指向执行节点服务器（Server 2）的 IP 地址，Nginx upstream 使用
RUNTIME_HOST=192.168.1.2
RUNTIME_PORT=3061

# ==================== WebSocket 服务配置 ====================
# console 和 websocket 部署在同一台服务器，使用容器名互通
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=gmd-faq-websocket
WEBSOCKET_PORT=3064
WEBSOCKET_MEM_LIMIT=1g
WEBSOCKET_CPU_LIMIT=2
WEBSOCKET_JAVA_HEAP_PERCENTAGE=50.0

# ==================== 路径配置 ====================
# DATA_PATH=./data
# LOG_PATH=./logs
