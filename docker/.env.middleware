# ============================================================
# GMD-FAQ 生产部署 - 中间件服务器 环境配置（.env.middleware）
# 部署位置：中间件服务器（Server 3）
# 使用方式：由 start-middleware.sh 自动复制为 .env（也可手动复制后填写实际值）
# ============================================================

# ==================== MySQL 配置 ====================
MYSQL_PORT=3306
MYSQL_DATABASE=gmd_faq_server
MYSQL_ROOT_PASSWORD=root

# ==================== Redis 配置 ====================
REDIS_PORT=6379
REDIS_PASSWORD=redis

# ==================== 向量库配置 ====================
PG_PORT=5432
PG_DATABASE=gmd_faq_vector
PG_USER=postgres
PG_PASSWORD=postgres

# ==================== 镜像仓库配置 ====================
DOCKER_REGISTRY=

# ==================== 路径配置 ====================
# DATA_PATH=./data
