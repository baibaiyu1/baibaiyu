# ============================================================
# GMD-FAQ 单机体验版 环境配置（.env.simple）
# 使用方式：由 start-simple.sh 自动复制为 .env
# 所有服务部署在同一台机器上，HOST 均指向容器名
# ============================================================

# ==================== MySQL 配置 ====================
MYSQL_HOST=gmd-faq-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=gmd_faq_server
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# ==================== Redis 配置 ====================
REDIS_HOST=gmd-faq-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DATABASE=7

# ==================== 向量库配置 ====================
VECTOR_STORE_TYPE=pgvector

# pgvector 配置（VECTOR_STORE_TYPE=pgvector 时生效）
PG_HOST=gmd-faq-pgvector
PG_PORT=5432
PG_DATABASE=gmd_faq_vector
PG_USER=postgres
PG_PASSWORD=postgres

# ==================== 镜像仓库配置 ====================
# Docker 镜像私有仓库前缀，留空则使用 Docker Hub
# 示例: DOCKER_REGISTRY=docker.your-company.com/
DOCKER_REGISTRY=

# ==================== 后端配置 ====================
JWT_SECRET=replace-with-your-own-random-secret-at-least-32-bytes

# console 资源限制
CONSOLE_MEM_LIMIT=2g
CONSOLE_CPU_LIMIT=4
CONSOLE_JAVA_HEAP_PERCENTAGE=75.0

# runtime 资源限制
RUNTIME_MEM_LIMIT=4g
RUNTIME_CPU_LIMIT=4
RUNTIME_JAVA_HEAP_PERCENTAGE=75.0

# gateway 资源限制
GATEWAY_MEM_LIMIT=4g
GATEWAY_CPU_LIMIT=4
GATEWAY_JAVA_HEAP_PERCENTAGE=75.0

# ==================== 前端配置 ====================
FRONTEND_PORT=80
VITE_APP_BASE_API=/web
VITE_APP_CONTEXT_PATH=/web

# ==================== Shell 执行代理配置 ====================
SHELLPROXY_MEM_LIMIT=1g
SHELLPROXY_CPU_LIMIT=2
SHELLPROXY_PIDS_LIMIT=200
SHELLPROXY_DEFAULT_TIMEOUT=300
SHELLPROXY_MAX_TIMEOUT=3600
SHELLPROXY_MAX_OUTPUT_SIZE=52428800
SHELLPROXY_JAVA_HEAP_PERCENTAGE=50.0

# ==================== WebSocket 服务配置 ====================
# WebSocket 服务地址（供 console/runtime 连接）
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=gmd-faq-websocket
WEBSOCKET_PORT=3064

# websocket 资源限制
WEBSOCKET_MEM_LIMIT=1g
WEBSOCKET_CPU_LIMIT=2
WEBSOCKET_JAVA_HEAP_PERCENTAGE=50.0

# ==================== Workspace 配置 ====================
WORKSPACE_CAPACITY_MB=30

# ==================== 博查联网搜索（绑定 web_search 工具后使用） ====================
BOCHA_API_KEY=
BOCHA_API_URL=https://api.bocha.cn/v1/web-search
BOCHA_TIMEOUT_SECONDS=20
BOCHA_MAX_RESULTS=10

# ==================== 路径配置 ====================
# DATA_PATH=./data
# LOG_PATH=./logs

# ==================== 心跳标识 ====================
# start-simple.sh 会按宿主机自动检测并注入；
# 若直接执行 docker compose（不走启动脚本），请取消注释并填写，否则节点主机名/IP 上报为空。
# GMD_FAQ_NODE_ID=
# GMD_FAQ_HOST_NAME=
# GMD_FAQ_HOST_IP=
