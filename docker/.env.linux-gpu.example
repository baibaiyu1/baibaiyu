# Linux 单机 GPU 部署。执行 bash docker/linux-gpu.sh init 生成独立配置。
# 空白凭据由 init 填入随机值；已有配置不会被覆盖。
COMPOSE_PROJECT_NAME=gmd-linux-gpu
COMPOSE_PARALLEL_LIMIT=2
DOCKER_REGISTRY=

MYSQL_DATABASE=gmd_faq_server
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DATABASE=7
VECTOR_STORE_TYPE=pgvector
PG_DATABASE=gmd_faq_vector
PG_USER=postgres
PG_PASSWORD=
PG_PORT=5432
JWT_SECRET=

FRONTEND_PORT=80
VITE_APP_BASE_API=/web
VITE_APP_CONTEXT_PATH=/web
CONSOLE_MEM_LIMIT=2g
CONSOLE_CPU_LIMIT=4
CONSOLE_JAVA_HEAP_PERCENTAGE=75.0
RUNTIME_MEM_LIMIT=4g
RUNTIME_CPU_LIMIT=4
RUNTIME_JAVA_HEAP_PERCENTAGE=75.0
GATEWAY_MEM_LIMIT=4g
GATEWAY_CPU_LIMIT=4
GATEWAY_JAVA_HEAP_PERCENTAGE=75.0
WEBSOCKET_ENABLED=true
WEBSOCKET_HOST=gmd-faq-websocket
WEBSOCKET_PORT=3064
WEBSOCKET_MEM_LIMIT=1g
WEBSOCKET_CPU_LIMIT=2
WEBSOCKET_JAVA_HEAP_PERCENTAGE=50.0
SHELLPROXY_MEM_LIMIT=1g
SHELLPROXY_CPU_LIMIT=2
SHELLPROXY_PIDS_LIMIT=200
SHELLPROXY_DEFAULT_TIMEOUT=300
SHELLPROXY_MAX_TIMEOUT=3600
SHELLPROXY_MAX_OUTPUT_SIZE=52428800
SHELLPROXY_JAVA_HEAP_PERCENTAGE=50.0
WORKSPACE_CAPACITY_MB=30

# 相对路径均相对于本仓库 docker/；可改成 Linux 绝对路径。
DATA_PATH=./data/linux-gpu
LOG_PATH=./logs/linux-gpu
GMD_FAQ_NODE_ID=linux-gpu-01
GMD_FAQ_HOST_NAME=
GMD_FAQ_HOST_IP=

# 默认使用本仓库内的 Python 后端；保留该项供显式指定兼容源码快照。
LIGHTRAG_SOURCE_DIR=../services/lightrag
LIGHTRAG_IMAGE=gmd/lightrag-api:local
LIGHTRAG_API_KEY=
# 迁移现有数据时必须与原 WORKSPACE 完全一致，空值表示默认工作区。
LIGHTRAG_WORKSPACE=
LIGHTRAG_MEM_LIMIT=4g
LIGHTRAG_CPU_LIMIT=4

# 模型文件单独准备到项目 models/mineru；路径应直接包含 models/Layout、models/OCR 等。
MINERU_MODELS_DIR=../models/mineru
MINERU_IMAGE=gmd/mineru-api:3.4.5-cuda12.8
MINERU_BASE_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
MINERU_GPU_ID=0
MINERU_MEM_LIMIT=8g
MINERU_CPU_LIMIT=4
MINERU_SHM_SIZE=2g
MINERU_API_TASK_RETENTION_SECONDS=86400
MINERU_API_TASK_CLEANUP_INTERVAL_SECONDS=300

BOCHA_API_KEY=
BOCHA_API_URL=https://api.bocha.cn/v1/web-search
BOCHA_TIMEOUT_SECONDS=20
BOCHA_MAX_RESULTS=10
